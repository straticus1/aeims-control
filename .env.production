# AEIMS Production Environment Configuration
# Generated by Claude Code for complete production deployment

# Database Configuration
POSTGRES_DB=aeims_production
POSTGRES_USER=aeims_prod
POSTGRES_PASSWORD=AeimsProduction2024!
MYSQL_ROOT_PASSWORD=RootPass2024!
MYSQL_DATABASE=aeims_legacy
MYSQL_USER=aeims_legacy
MYSQL_PASSWORD=AeimsLegacy2024!

# Redis Configuration
REDIS_PASSWORD=AeimsRedis2024!

# Application Security
JWT_SECRET=AeimsJwtSecretProduction2024ComplexKey!
ENCRYPTION_KEY=AeimsEncryptionKeyProduction2024ComplexKey!

# Service Configuration
NODE_ENV=production
REACT_APP_ENV=production
PHP_ENV=production

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# Network Configuration
WEBSOCKET_PORT=8080
API_PORT=8000
ADMIN_PORT=80
APP_PORT=3000

# ALB Health Check Configuration
HEALTH_CHECK_PORT=8080
HEALTH_CHECK_PATH=/health

# VoIP & Telephony Configuration
ASTERISK_HOST=localhost
ASTERISK_PORT=5060
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000

# Adult Content Platform Configuration
AGE_VERIFICATION_ENABLED=true
CONTENT_FILTERING_ENABLED=true
PRIVACY_COMPLIANCE=GDPR,CCPA
ADULT_CONTENT_WARNING=true

# Monitoring & Analytics
MONITORING_ENABLED=true
ANALYTICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Backup & Recovery
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl
SSL_KEY_PATH=/etc/nginx/ssl

# Performance Tuning
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000
WORKER_PROCESSES=auto