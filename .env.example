# AEIMS Infrastructure Management System
# Environment Configuration Template

# ====================
# General Configuration
# ====================
ENVIRONMENT=dev
AEIMS_VERSION=latest

# Build Configuration
BUILD_DATE=
NODE_ENV=development

# ====================
# Database Configuration
# ====================

# AEIMS Core (PostgreSQL)
AEIMS_CORE_DB_NAME=aeims_core
AEIMS_CORE_DB_USER=aeims_user
AEIMS_CORE_DB_PASS=secure_password_123
AEIMS_CORE_DB_PORT=5432

# AEIMS App (MySQL)
AEIMS_APP_DB_NAME=aeims_app
AEIMS_APP_DB_USER=aeims_user
AEIMS_APP_DB_PASS=secure_password_123
AEIMS_APP_DB_ROOT_PASS=secure_root_pass_123
AEIMS_APP_DB_PORT=3306

# Redis (Shared)
REDIS_PASSWORD=secure_redis_pass
REDIS_PORT=6379

# ====================
# Service Ports
# ====================

# Main Services
AEIMS_CORE_PORT=8000
AEIMS_APP_PORT=81
AEIMS_APP_SSL_PORT=444
AEIMS_LIB_PORT=8080
AEIMS_FRONTEND_PORT=3000

# Microservices (AEIMS Core)
AEIMS_USER_SERVICE_PORT=8001
AEIMS_BILLING_SERVICE_PORT=8002
AEIMS_CALL_SERVICE_PORT=8003
AEIMS_OPERATOR_SERVICE_PORT=8004
AEIMS_CONFERENCE_SERVICE_PORT=8005
AEIMS_NOTIFICATION_SERVICE_PORT=8006
AEIMS_ANALYTICS_SERVICE_PORT=8007

# Load Balancer
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin123

# ====================
# Service Integration URLs
# ====================

# Internal service communication
AEIMS_CORE_URL=http://aeims-core:8000
AEIMS_APP_URL=http://aeims-app:80
AEIMS_LIB_URL=http://aeims-lib:8080

# External URLs (for frontend/client connections)
EXTERNAL_AEIMS_CORE_URL=http://localhost:8000
EXTERNAL_AEIMS_APP_URL=http://localhost:81
EXTERNAL_AEIMS_LIB_URL=http://localhost:8080

# ====================
# AWS Configuration (for cloud deployment)
# ====================
AWS_REGION=us-west-2
AWS_PROFILE=default

# Terraform State
TF_STATE_BUCKET=aeims-terraform-state-dev

# ====================
# Security Configuration
# ====================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# API Keys
AEIMS_API_KEY=your-api-key-here
AEIMS_WEBHOOK_SECRET=your-webhook-secret-here

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/aeims.crt
SSL_KEY_PATH=/etc/ssl/private/aeims.key

# ====================
# Email Configuration
# ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=AEIMS <noreply@example.com>

# ====================
# Telephony Configuration
# ====================

# FreeSWITCH
FREESWITCH_HOST=localhost
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon

# SIP Configuration
SIP_DOMAIN=localhost
SIP_PROXY=localhost:5060

# ====================
# Logging and Monitoring
# ====================
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (Error Tracking)
SENTRY_DSN=

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9100

# ====================
# Feature Flags
# ====================
ENABLE_AEIMS_CORE=true
ENABLE_AEIMS_APP=true
ENABLE_AEIMS_LIB=true
ENABLE_MONITORING=true
ENABLE_SSL=false
ENABLE_DEBUG=false

# ====================
# Development Configuration
# ====================

# Hot Reload
ENABLE_HOT_RELOAD=true

# Debug Ports
AEIMS_CORE_DEBUG_PORT=9229
AEIMS_LIB_DEBUG_PORT=9230

# Test Database
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/aeims_test

# ====================
# Backup Configuration
# ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=aeims-backups

# ====================
# Cache Configuration
# ====================
CACHE_TTL=3600
CACHE_PREFIX=aeims:

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ====================
# WebSocket Configuration
# ====================
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=60000

# ====================
# File Upload Configuration
# ====================
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# ====================
# Notification Configuration
# ====================
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_EMAIL_ENABLED=true

# ====================
# Device Management (AEIMS Lib)
# ====================
DEVICE_DISCOVERY_ENABLED=true
DEVICE_AUTO_CONNECT=false
DEVICE_TIMEOUT=30000

# ====================
# Analytics Configuration
# ====================
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# ====================
# Compliance Configuration
# ====================
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years
AUDIT_LOG_ENABLED=true