# Terraform Backend Configuration for AEIMS
# Copy this file to backend.conf and update the values

bucket  = "aeims-terraform-state-${ENVIRONMENT}"
key     = "aeims/terraform.tfstate"
region  = "us-west-2"
encrypt = true

# Optional: Add DynamoDB table for state locking
dynamodb_table = "aeims-terraform-locks-${ENVIRONMENT}"

# Optional: Add KMS key for additional encryption
# kms_key_id = "arn:aws:kms:us-west-2:123456789012:key/12345678-1234-1234-1234-123456789012"