version: '3.8'

# AEIMS Complete Infrastructure Management System
# Master Docker Compose for all AEIMS services integration
# Orchestrates AEIMS Core, AEIMS App, and AEIMS Lib together

networks:
  aeims-network:
    driver: bridge
    name: aeims-integrated-network

volumes:
  # Persistent data volumes
  aeims_core_postgres_data:
    name: aeims-core-postgres-data
  aeims_app_mysql_data:
    name: aeims-app-mysql-data
  aeims_redis_data:
    name: aeims-redis-data
  aeims_logs:
    name: aeims-logs
  aeims_uploads:
    name: aeims-uploads

services:
  # ====================
  # Database Services
  # ====================
  
  # PostgreSQL for AEIMS Core
  aeims-core-postgres:
    image: postgres:14
    container_name: aeims-core-postgres
    environment:
      POSTGRES_DB: ${AEIMS_CORE_DB_NAME:-aeims_core}
      POSTGRES_USER: ${AEIMS_CORE_DB_USER:-aeims_user}
      POSTGRES_PASSWORD: ${AEIMS_CORE_DB_PASS:-secure_password_123}
    ports:
      - "${AEIMS_CORE_DB_PORT:-5432}:5432"
    volumes:
      - aeims_core_postgres_data:/var/lib/postgresql/data
      - ../aeims/database:/docker-entrypoint-initdb.d:ro
    networks:
      - aeims-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${AEIMS_CORE_DB_USER:-aeims_user}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # MySQL for AEIMS App
  aeims-app-mysql:
    image: mysql:8.0
    container_name: aeims-app-mysql
    environment:
      MYSQL_ROOT_PASSWORD: ${AEIMS_APP_DB_ROOT_PASS:-secure_root_pass_123}
      MYSQL_DATABASE: ${AEIMS_APP_DB_NAME:-aeims_app}
      MYSQL_USER: ${AEIMS_APP_DB_USER:-aeims_user}
      MYSQL_PASSWORD: ${AEIMS_APP_DB_PASS:-secure_password_123}
    ports:
      - "${AEIMS_APP_DB_PORT:-3306}:3306"
    volumes:
      - aeims_app_mysql_data:/var/lib/mysql
      - ../aeims.app/database:/docker-entrypoint-initdb.d:ro
    networks:
      - aeims-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u${AEIMS_APP_DB_USER:-aeims_user}", "-p${AEIMS_APP_DB_PASS:-secure_password_123}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  # Redis for all services
  aeims-redis:
    image: redis:7-alpine
    container_name: aeims-redis
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - aeims_redis_data:/data
    networks:
      - aeims-network
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  # ====================
  # AEIMS Core Services
  # ====================

  # AEIMS Core Platform  
  aeims-core:
    build:
      context: ../aeims
      dockerfile: Dockerfile
      args:
        - ENVIRONMENT=${ENVIRONMENT:-dev}
        - BUILD_DATE=${BUILD_DATE:-2024-01-01T00:00:00Z}
        - BUILD_TARGET=${BUILD_TARGET:-production}
      target: ${BUILD_TARGET:-production}
    container_name: aeims-core
    environment:
      - ENVIRONMENT=${ENVIRONMENT:-dev}
      - DB_HOST=aeims-core-postgres
      - DB_NAME=${AEIMS_CORE_DB_NAME:-aeims_core}
      - DB_USER=${AEIMS_CORE_DB_USER:-aeims_user}
      - DB_PASS=${AEIMS_CORE_DB_PASS:-secure_password_123}
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
      - AEIMS_APP_URL=http://aeims-app
      - AEIMS_LIB_URL=http://aeims-lib:8080
      - API_PORT=8000
    ports:
      - "${AEIMS_CORE_PORT:-8000}:8000"
    volumes:
      - aeims_logs:/var/log/aeims
      - aeims_uploads:/var/uploads
    networks:
      - aeims-network
    depends_on:
      aeims-core-postgres:
        condition: service_healthy
      aeims-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    restart: unless-stopped
    labels:
      - "aeims.service=core"
      - "aeims.type=telephony-platform"

  # User Service
  aeims-user-service:
    build:
      context: ../aeims/telephony-platform/services/user-service
      dockerfile: Dockerfile
      args:
        - ENVIRONMENT=${ENVIRONMENT:-dev}
        - SERVICE_NAME=user-service
    container_name: aeims-user-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8001:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Billing Service
  aeims-billing-service:
    build:
      context: ../aeims/telephony-platform/services/billing-service
      dockerfile: Dockerfile
    container_name: aeims-billing-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8002:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Call Service
  aeims-call-service:
    build:
      context: ../aeims/telephony-platform/services/call-service
      dockerfile: Dockerfile
    container_name: aeims-call-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8003:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Operator Service
  aeims-operator-service:
    build:
      context: ../aeims/telephony-platform/services/operator-service
      dockerfile: Dockerfile
    container_name: aeims-operator-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8004:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Conference Service
  aeims-conference-service:
    build:
      context: ../aeims/telephony-platform/services/conference-service
      dockerfile: Dockerfile
    container_name: aeims-conference-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8005:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Notification Service
  aeims-notification-service:
    build:
      context: ../aeims/telephony-platform/services/notification-service
      dockerfile: Dockerfile
    container_name: aeims-notification-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8006:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Analytics Service
  aeims-analytics-service:
    build:
      context: ../aeims/telephony-platform/services/analytics-service
      dockerfile: Dockerfile
    container_name: aeims-analytics-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8007:9000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Admin Service
  aeims-admin-service:
    build:
      context: ../aeims/telephony-platform/services/admin-service
      dockerfile: Dockerfile
    container_name: aeims-admin-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8008:8000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Content Service
  aeims-content-service:
    build:
      context: ../aeims/telephony-platform/services/content-service
      dockerfile: Dockerfile
    container_name: aeims-content-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8009:8000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # File Service
  aeims-file-service:
    build:
      context: ../aeims/telephony-platform/services/file-service
      dockerfile: Dockerfile
    container_name: aeims-file-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8010:8000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Marketing Service
  aeims-marketing-service:
    build:
      context: ../aeims/telephony-platform/services/marketing-service
      dockerfile: Dockerfile
    container_name: aeims-marketing-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8011:8000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # Verification Service
  aeims-verification-service:
    build:
      context: ../aeims/telephony-platform/services/verification-service
      dockerfile: Dockerfile
    container_name: aeims-verification-service
    environment:
      - DB_HOST=aeims-core-postgres
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
    ports:
      - "8012:8000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core-postgres
      - aeims-redis
    restart: unless-stopped

  # ====================
  # AEIMS App (Showcase)
  # ====================

  aeims-app:
    build:
      context: ../aeims.app
      dockerfile: infrastructure/Dockerfile
    container_name: aeims-app
    environment:
      - ENVIRONMENT=${ENVIRONMENT:-dev}
      - DB_HOST=aeims-app-mysql
      - DB_NAME=${AEIMS_APP_DB_NAME:-aeims_app}
      - DB_USER=${AEIMS_APP_DB_USER:-aeims_user}
      - DB_PASS=${AEIMS_APP_DB_PASS:-secure_password_123}
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
      - AEIMS_CORE_URL=http://aeims-core:8000
      - AEIMS_LIB_URL=http://aeims-lib:8080
    ports:
      - "${AEIMS_APP_PORT:-80}:80"
      - "${AEIMS_APP_SSL_PORT:-443}:443"
    volumes:
      - aeims_logs:/var/log/nginx
      - aeims_uploads:/var/uploads
    networks:
      - aeims-network
    depends_on:
      aeims-app-mysql:
        condition: service_healthy
      aeims-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    restart: unless-stopped
    labels:
      - "aeims.service=app"
      - "aeims.type=showcase-website"

  # ====================
  # AEIMS Lib (Device Management)
  # ====================

  aeims-lib:
    build:
      context: ../aeimsLib
      dockerfile: Dockerfile-simple
    container_name: aeims-lib
    environment:
      - NODE_ENV=${NODE_ENV:-production}
      - WEBSOCKET_PORT=8080
      - REDIS_HOST=aeims-redis
      - REDIS_PASSWORD=${REDIS_PASSWORD:-secure_redis_pass}
      - AEIMS_CORE_URL=http://aeims-core:8000
      - AEIMS_APP_URL=http://aeims-app
      - JWT_SECRET=${JWT_SECRET:-shared_jwt_secret_key}
      - LOG_LEVEL=${LOG_LEVEL:-info}
    ports:
      - "${AEIMS_LIB_PORT:-8081}:8080"
    volumes:
      - aeims_logs:/app/logs
    networks:
      - aeims-network
    depends_on:
      aeims-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped
    labels:
      - "aeims.service=lib"
      - "aeims.type=device-management"

  # ====================
  # Frontend Services
  # ====================

  # React Frontend (from AEIMS Core)
  aeims-frontend:
    build:
      context: ../aeims/telephony-platform
      dockerfile: frontend/Dockerfile
      target: production
    container_name: aeims-frontend
    environment:
      - REACT_APP_API_BASE_URL=https://api.sexacomms.com
      - REACT_APP_WS_URL=wss://api.sexacomms.com/ws
      - REACT_APP_ENVIRONMENT=${ENVIRONMENT:-production}
      - REACT_APP_LOGIN_URL=https://login.sexacomms.com
    ports:
      - "${AEIMS_FRONTEND_PORT:-3000}:3000"
    networks:
      - aeims-network
    depends_on:
      - aeims-core
      - aeims-lib
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # ====================
  # Load Balancer / Reverse Proxy
  # ====================

  # PHP-FPM for site processing
  aeims-php-fpm:
    image: php:8.2-fpm
    container_name: aeims-php-fpm
    volumes:
      - ../aeims/sites:/var/www/sites:ro
    networks:
      - aeims-network
    restart: unless-stopped

  aeims-nginx:
    build:
      context: ./nginx
      dockerfile: Dockerfile
    container_name: aeims-nginx
    ports:
      - "${NGINX_HTTP_PORT:-8082}:80"
      - "${NGINX_HTTPS_PORT:-8443}:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
      - aeims_logs:/var/log/nginx
      - ../aeims/sites:/var/www/sites:ro
    networks:
      - aeims-network
    depends_on:
      - aeims-core
      - aeims-app
      - aeims-lib
      - aeims-frontend
      - aeims-php-fpm
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped

  # ====================
  # Monitoring Services
  # ====================

  # Health Monitor - Centralized health checking
  aeims-health-monitor:
    image: nginx:alpine
    container_name: aeims-health-monitor
    ports:
      - "${HEALTH_MONITOR_PORT:-8090}:80"
    volumes:
      - ./monitoring/health-monitor.conf:/etc/nginx/nginx.conf:ro
    networks:
      - aeims-network
    depends_on:
      - aeims-core
      - aeims-app
      - aeims-lib
      - aeims-frontend
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    restart: unless-stopped
    labels:
      - "aeims.service=health-monitor"
      - "aeims.type=monitoring"

  # Prometheus for metrics collection
  aeims-prometheus:
    image: prom/prometheus:latest
    container_name: aeims-prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=200h'
      - '--web.enable-lifecycle'
    ports:
      - "${PROMETHEUS_PORT:-9090}:9090"
    volumes:
      - ./monitoring/prometheus:/etc/prometheus:ro
    networks:
      - aeims-network
    restart: unless-stopped
    profiles:
      - monitoring

  # Grafana for visualization
  aeims-grafana:
    image: grafana/grafana:latest
    container_name: aeims-grafana
    ports:
      - "${GRAFANA_PORT:-3001}:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin123}
      - GF_USERS_ALLOW_SIGN_UP=false
    volumes:
      - ./monitoring/grafana:/etc/grafana/provisioning:ro
    networks:
      - aeims-network
    depends_on:
      - aeims-prometheus
    restart: unless-stopped
    profiles:
      - monitoring

# ====================
# Additional Configurations
# ====================

# Service discovery labels
x-aeims-labels: &aeims-labels
  labels:
    - "aeims.project=aeims-control"
    - "aeims.version=${AEIMS_VERSION:-latest}"
    - "aeims.environment=${ENVIRONMENT:-dev}"