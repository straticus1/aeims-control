#!/usr/bin/env bash
##
# AEIMS Remote Control Wrapper
# Routes commands to local Docker or remote AWS API based on REMOTE mode
##

set -e

# Load environment
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -f "$SCRIPT_DIR/.env" ]; then
    source "$SCRIPT_DIR/.env"
fi

# Default to AWS mode
REMOTE=${REMOTE:-aws}
CONTROL_API_URL=${AEIMS_CONTROL_API_URL:-https://control-api.aeims.app}
CONTROL_API_KEY=${AEIMS_CONTROL_API_KEY}

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Function to call remote API
call_api() {
    local method="$1"
    local endpoint="$2"
    local data="$3"

    if [ -z "$CONTROL_API_KEY" ]; then
        echo -e "${RED}Error: AEIMS_CONTROL_API_KEY not set${NC}"
        echo "Set it in .env or export AEIMS_CONTROL_API_KEY=your-key"
        exit 1
    fi

    local url="${CONTROL_API_URL}${endpoint}"
    local curl_opts="-s -X ${method} -H 'X-API-Key: ${CONTROL_API_KEY}'"

    if [ -n "$data" ]; then
        curl_opts="${curl_opts} -H 'Content-Type: application/json' -d '${data}'"
    fi

    eval curl $curl_opts "$url"
}

# Command handlers
cmd_list() {
    if [ "$REMOTE" = "aws" ]; then
        echo -e "${GREEN}[AWS] Listing services...${NC}"
        call_api GET "/api/services" | jq .
    else
        echo -e "${YELLOW}[LOCAL] Listing services...${NC}"
        cd "$SCRIPT_DIR" && docker-compose ps
    fi
}

cmd_status() {
    local service="$1"

    if [ "$REMOTE" = "aws" ]; then
        if [ -z "$service" ]; then
            call_api GET "/api/cluster/status" | jq .
        else
            call_api GET "/api/services/${service}/status" | jq .
        fi
    else
        cd "$SCRIPT_DIR" && docker-compose ps "$service"
    fi
}

cmd_restart() {
    local service="$1"

    if [ -z "$service" ]; then
        echo "Usage: aeims-remote restart <service>"
        exit 1
    fi

    if [ "$REMOTE" = "aws" ]; then
        echo -e "${GREEN}[AWS] Restarting ${service}...${NC}"
        call_api POST "/api/services/${service}/restart" | jq .
    else
        echo -e "${YELLOW}[LOCAL] Restarting ${service}...${NC}"
        cd "$SCRIPT_DIR" && docker-compose restart "$service"
    fi
}

cmd_logs() {
    local service="$1"
    local limit="${2:-100}"

    if [ -z "$service" ]; then
        echo "Usage: aeims-remote logs <service> [limit]"
        exit 1
    fi

    if [ "$REMOTE" = "aws" ]; then
        echo -e "${GREEN}[AWS] Fetching logs for ${service}...${NC}"
        call_api GET "/api/services/${service}/logs?limit=${limit}" | jq -r '.logs[] | .timestamp + " " + .message'
    else
        echo -e "${YELLOW}[LOCAL] Fetching logs for ${service}...${NC}"
        cd "$SCRIPT_DIR" && docker-compose logs --tail="$limit" "$service"
    fi
}

cmd_deploy() {
    local service="$1"
    local image_tag="$2"

    if [ -z "$service" ]; then
        echo "Usage: aeims-remote deploy <service> [image-tag]"
        exit 1
    fi

    if [ "$REMOTE" = "aws" ]; then
        echo -e "${GREEN}[AWS] Deploying ${service}...${NC}"

        if [ -n "$image_tag" ]; then
            call_api POST "/api/services/${service}/deploy" "{\"imageTag\":\"${image_tag}\"}" | jq .
        else
            call_api POST "/api/services/${service}/deploy" | jq .
        fi
    elif [ "$REMOTE" = "install" ]; then
        echo -e "${YELLOW}[INSTALL] Running full deployment...${NC}"
        cd "$SCRIPT_DIR" && ./deploy-unified.sh
    else
        echo -e "${YELLOW}[LOCAL] Deploying ${service}...${NC}"
        cd "$SCRIPT_DIR" && docker-compose up -d --build "$service"
    fi
}

cmd_scale() {
    local service="$1"
    local count="$2"

    if [ -z "$service" ] || [ -z "$count" ]; then
        echo "Usage: aeims-remote scale <service> <count>"
        exit 1
    fi

    if [ "$REMOTE" = "aws" ]; then
        echo -e "${GREEN}[AWS] Scaling ${service} to ${count} instances...${NC}"
        call_api POST "/api/services/${service}/scale" "{\"desiredCount\":${count}}" | jq .
    else
        echo -e "${YELLOW}[LOCAL] Scaling ${service} to ${count} instances...${NC}"
        cd "$SCRIPT_DIR" && docker-compose up -d --scale "$service=$count"
    fi
}

# Main command router
COMMAND="$1"
shift || true

case "$COMMAND" in
    list|ls)
        cmd_list "$@"
        ;;
    status)
        cmd_status "$@"
        ;;
    restart)
        cmd_restart "$@"
        ;;
    logs)
        cmd_logs "$@"
        ;;
    deploy)
        cmd_deploy "$@"
        ;;
    scale)
        cmd_scale "$@"
        ;;
    mode)
        echo "Current mode: $REMOTE"
        echo "API URL: $CONTROL_API_URL"
        ;;
    help|--help|-h)
        echo "AEIMS Remote Control"
        echo ""
        echo "Mode: $REMOTE (set REMOTE=local|aws|install)"
        echo ""
        echo "Commands:"
        echo "  list                  List all services"
        echo "  status [service]      Get service or cluster status"
        echo "  restart <service>     Restart a service"
        echo "  logs <service> [n]    View service logs (last n lines)"
        echo "  deploy <service> [tag] Deploy service (with optional image tag)"
        echo "  scale <service> <n>   Scale service to n instances"
        echo "  mode                  Show current mode"
        echo ""
        echo "Examples:"
        echo "  REMOTE=aws aeims-remote list"
        echo "  REMOTE=local aeims-remote restart aeims-web-service"
        echo "  REMOTE=install aeims-remote deploy all"
        ;;
    *)
        echo "Unknown command: $COMMAND"
        echo "Use 'aeims-remote help' for usage"
        exit 1
        ;;
esac
